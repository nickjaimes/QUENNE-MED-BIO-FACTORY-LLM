YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Functions
print_banner() {
    clear
    echo -e "${BLUE}"
    echo "╔══════════════════════════════════════════════════════════════════════════════╗"
    echo "║                                                                              ║"
    echo "║   ██████  ██    ██ ███████ ███    ██ ███    ██ ███████ ██████  ███████ ██████║"
    echo "║  ██    ██ ██    ██ ██      ████   ██ ████   ██ ██      ██   ██ ██      ██   ██║"
    echo "║  ██    ██ ██    ██ █████   ██ ██  ██ ██ ██  ██ █████   ██████  █████   ██   ██║"
    echo "║  ██    ██ ██    ██ ██      ██  ██ ██ ██  ██ ██ ██      ██   ██ ██      ██   ██║"
    echo "║   ██████   ██████  ███████ ██   ████ ██   ████ ███████ ██   ██ ███████ ██████ ║"
    echo "║                                                                              ║"
    echo "║                     BIO-FACTORY AI HUMANOID ROBOT                            ║"
    echo "║                         Complete Deployment System                           ║"
    echo "║                          Environment: $DEPLOYMENT_ENV                        ║"
