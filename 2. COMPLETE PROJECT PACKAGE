setup_backup_system() {
    print_step "Setting up Backup System..."
    
    # Create backup scripts
    cat > "$PROJECT_ROOT/scripts/backup/full_backup.sh" << 'EOF'
#!/bin/bash
# Full system backup script

BACKUP_DIR="/backups"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_NAME="quennemed_full_backup_$TIMESTAMP.tar.gz"

echo "Starting full system backup..."

# Backup databases
docker exec quennemed-postgres pg_dumpall -U quennemed > "$BACKUP_DIR/database_backup.sql"

# Backup configuration
tar -czf "$BACKUP_DIR/config_backup.tar.gz" -C / config/

# Backup models
tar -czf "$BACKUP_DIR/models_backup.tar.gz" -C / data/models/

# Backup patient data
tar -czf "$BACKUP_DIR/patients_backup.tar.gz" -C / data/patients/ --exclude="*.tmp"

# Create full backup archive
tar -czf "$BACKUP_DIR/$BACKUP_NAME" \
    "$BACKUP_DIR/database_backup.sql" \
    "$BACKUP_DIR/config_backup.tar.gz" \
    "$BACKUP_DIR/models_backup.tar.gz" \
    "$BACKUP_DIR/patients_backup.tar.gz"

# Clean up temporary files
rm -f "$BACKUP_DIR/database_backup.sql" \
      "$BACKUP_DIR/config_backup.tar.gz" \
      "$BACKUP_DIR/models_backup.tar.gz" \
      "$BACKUP_DIR/patients_backup.tar.gz"

echo "Backup completed: $BACKUP_NAME"
EOF
    
    chmod +x "$PROJECT_ROOT/scripts/backup/full_backup.sh"
    
    # Setup cron job for daily backups
    (crontab -l 2>/dev/null; echo "0 2 * * * $PROJECT_ROOT/scripts/backup/full_backup.sh") | crontab -
    
    print_success "Backup System setup complete"
}

