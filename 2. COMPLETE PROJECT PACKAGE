                    f"{self.base_url}:8000/diagnose",
                    json={"symptoms": [f"symptom_{task_id}"]}
                ) as response:
                    await response.json()
            
            elif task_id % 3 == 1:
                # Surgical operation
                async with self.session.get(f"{self.base_url}:8001/health") as response:
                    await response.json()
            
            else:
                # Bioprinting operation
                async with self.session.get(f"{self.base_url}:8004/health") as response:
                    await response.json()
            
            return "success"
        except Exception:
            return "failure"
    
    # ==================== ERROR HANDLING TESTS ====================
    
    async def test_error_handling(self):
        """Test system error handling"""
        error_test_cases = [
            {
                "name": "invalid_json",
                "url": f"{self.base_url}:8000/diagnose",
                "data": "invalid json",
                "expected_status": 400
            },
            {
                "name": "missing_parameters",
                "url": f"{self.base_url}:8000/diagnose",
                "data": {},
                "expected_status": 400
            },
            {
                "name": "nonexistent_endpoint",
                "url": f"{self.base_url}:8000/nonexistent",
                "data": {},
                "expected_status": 404
            }
        ]
        
        for test_case in error_test_cases:
            try:
                async with self.session.post(
                    test_case["url"],
                    data=test_case["data"]
                ) as response:
                    assert response.status == test_case["expected_status"], \
                        f"Error test {test_case['name']} failed"
                    
                    error_data = await response.json()
                    assert "error" in error_data
                    assert "message" in error_data
                    
                    print(f"✓ Error handling test passed: {test_case['name']}")
            except Exception as e:
                pytest.fail(f"Error test {test_case['name']} error: {e}")
    
    # ==================== MAIN TEST RUNNER ====================
    
    async def run_all_tests(self):
        """Run all integration tests"""
        print("\n" + "="*80)
        print("QUENNE-MED SYSTEM INTEGRATION TESTS")
        print("="*80 + "\n")
        
        test_methods = [
            self.test_system_health,
            self.test_subsystem_health,
            self.test_ai_model_diagnosis,
            self.test_ai_model_surgical_planning,
            self.test_surgical_arm_calibration,
            self.test_surgical_motion_planning,
            self.test_bioprinting_calibration,
            self.test_bioink_preparation,
            self.test_vision_system_calibration,
            self.test_object_detection,
            self.test_safety_monitoring,
            self.test_emergency_stop,
            self.test_surgical_procedure_integration,
            self.test_bioprinting_integration,
            self.test_system_performance,
            self.test_concurrent_operations,
            self.test_error_handling
        ]
        
        results = {"passed": 0, "failed": 0, "errors": []}
        
        for test_method in test_methods:
            test_name = test_method.__name__
            print(f"\nRunning: {test_name}")
            print("-" * 40)
            
            try:
                await test_method()
                results["passed"] += 1
                print(f"✓ {test_name} PASSED")
            except AssertionError as e:
                results["failed"] += 1
                results["errors"].append(f"{test_name}: {str(e)}")
                print(f"✗ {test_name} FAILED: {str(e)}")
            except Exception as e:
                results["failed"] += 1
                results["errors"].append(f"{test_name}: Unexpected error: {str(e)}")
                print(f"✗ {test_name} ERROR: {str(e)}")
        
        # Print summary
        print("\n" + "="*80)
        print("TEST SUMMARY")
        print("="*80)
        print(f"Total Tests: {len(test_methods)}")
        print(f"Passed: {results['passed']}")
        print(f"Failed: {results['failed']}")
        
        if results["errors"]:
            print("\nErrors:")
            for error in results["errors"]:
                print(f"  - {error}")
        
        if results["failed"] == 0:
            print("\n✅ ALL TESTS PASSED!")
            return True
        else:
            print(f"\n❌ {results['failed']} TEST(S) FAILED")
            return False

async def main():
