    echo "║                                                                              ║"
    echo "╚══════════════════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

print_step() {
    echo -e "${CYAN}[$(date +%T)]${NC} ${YELLOW}▶${NC} $1"
    echo "[$(date)] STEP: $1" >> "$LOG_DIR/deployment_$TIMESTAMP.log"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
    echo "[$(date)] SUCCESS: $1" >> "$LOG_DIR/deployment_$TIMESTAMP.log"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
    echo "[$(date)] ERROR: $1" >> "$LOG_DIR/deployment_$TIMESTAMP.log"
    exit 1
}

print_warning() {
