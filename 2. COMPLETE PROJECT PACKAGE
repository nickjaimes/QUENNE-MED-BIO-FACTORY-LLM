check_prerequisites() {
    print_step "Checking system prerequisites..."
    
    # Check OS
    if [[ "$OSTYPE" != "linux-gnu"* ]] && [[ "$OSTYPE" != "darwin"* ]]; then
        print_error "Unsupported OS: $OSTYPE. Requires Linux or macOS."
    fi
    
    # Check Python
    if ! command -v python3 &> /dev/null; then
        print_error "Python 3.10+ is required but not installed."
    fi
    
    PYTHON_VERSION=$(python3 --version | cut -d' ' -f2)
    if [[ "$PYTHON_VERSION" < "3.10.0" ]]; then
        print_error "Python 3.10+ required. Found: $PYTHON_VERSION"
    fi
    print_success "Python $PYTHON_VERSION detected"
    
    # Check Docker
    if ! command -v docker &> /dev/null; then
        print_error "Docker is required but not installed."
    fi
    DOCKER_VERSION=$(docker --version | cut -d' ' -f3 | tr -d ',')
    print_success "Docker $DOCKER_VERSION detected"
    
    # Check Docker Compose
    if ! command -v docker-compose &> /dev/null; then
        print_error "Docker Compose is required but not installed."
    fi
    print_success "Docker Compose detected"
    
    # Check NVIDIA GPU (if applicable)
    if command -v nvidia-smi &> /dev/null; then
        CUDA_VERSION=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1)
        print_success "NVIDIA GPU detected with driver $CUDA_VERSION"
        GPU_ENABLED=true
    else
        print_warning "NVIDIA GPU not detected. Running in CPU-only mode."
        GPU_ENABLED=false
    fi
    
    # Check memory
    TOTAL_MEM=$(free -g | awk '/^Mem:/{print $2}')
    if [[ "$TOTAL_MEM" -lt 32 ]]; then
        print_warning "Low memory detected: ${TOTAL_MEM}GB (32GB recommended)"
    else
        print_success "Memory: ${TOTAL_MEM}GB"
    fi
    
    # Check storage
    TOTAL_DISK=$(df -BG "$PROJECT_ROOT" | awk 'NR==2 {print $4}' | tr -d 'G')
    if [[ "$TOTAL_DISK" -lt 100 ]]; then
        print_warning "Low disk space: ${TOTAL_DISK}GB (100GB recommended)"
    else
        print_success "Disk space: ${TOTAL_DISK}GB free"
    fi
    
    # Check network
    if ping -c 1 -W 2 8.8.8.8 &> /dev/null; then
        print_success "Network connectivity confirmed"
    else
        print_warning "No internet connectivity detected"
    fi
    
    print_success "All prerequisites checked"
}

