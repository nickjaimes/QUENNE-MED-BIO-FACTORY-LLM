                logging.info(f"Startup step completed: {step.__name__}")
            except Exception as e:
                logging.error(f"Startup step failed: {step.__name__} - {e}")
                await self.emergency_shutdown()
                return False
        
        self.state["operational"] = True
        logging.info("System startup complete - Ready for operation")
