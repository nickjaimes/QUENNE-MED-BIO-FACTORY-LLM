        # Power sequence (critical order)
        power_sequence = [
            "safety",
            "med_ros",
            "emergency",
            "communication",
            "monitor",
            "vision",
            "llm",
            "surgical",
            "biomanufacturing"
        ]
        
        for subsystem in power_sequence:
            if subsystem in self.subsystems:
                await self.subsystems[subsystem].power_on()
                await asyncio.sleep(0.1)  # Small delay between power-ups
    
    async def self_test(self):
        """Run comprehensive self-test"""
        logging.info("Running self-test...")
        
        test_results = {}
        
        for name, subsystem in self.subsystems.items():
            try:
                result = await subsystem.self_test()
                test_results[name] = result
                
                if not result["passed"]:
                    logging.warning(f"Subsystem {name} self-test failed: {result['error']}")
            except Exception as e:
                test_results[name] = {"passed": False, "error": str(e)}
                logging.error(f"Subsystem {name} self-test exception: {e}")
        
        # Check overall test results
        all_passed = all(result["passed"] for result in test_results.values())
        
        if not all_passed:
            failed = [name for name, result in test_results.items() if not result["passed"]]
            raise Exception(f"Self-test failed for subsystems: {failed}")
        
        logging.info("Self-test passed for all subsystems")
        return test_results
    
